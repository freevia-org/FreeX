<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Avalonia.Native.UnitTests</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AvaloniaPublicSigningKey Condition="'$(AvaloniaPublicSigningKey)' == ''">$(MSBuildThisFileDirectory)Fixtures/Avalonia.Public.snk</AvaloniaPublicSigningKey>
    <AssemblyOriginatorKeyFile>$(AvaloniaPublicSigningKey)</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Native" VersionOverride="12.0.5-freex.grid.5" />
  </ItemGroup>
  <Target Name="RequirePublicTestSigningKey" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(AvaloniaPublicSigningKey)')" Text="The public test-signing fixture is missing; restore Fixtures/Avalonia.Public.snk or supply the matching AvaloniaPublicSigningKey." />
  </Target>
</Project>
