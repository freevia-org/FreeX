<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Free.Shared.Drawing/Free.Shared.Drawing.csproj" />
    <ProjectReference Include="../../shared/Free.Shared.Pdf/Free.Shared.Pdf.csproj" />
    <ProjectReference Include="../../shared/Free.Shared.Pdf.Skia/Free.Shared.Pdf.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the unmodified product fonts and their license; do not duplicate binaries or QA evidence. -->
    <None Include="../../freew/FreeW.App.Avalonia/Assets/Fonts/Carlito/*.ttf"
          Link="Fixtures/Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../freew/FreeW.App.Avalonia/Assets/Fonts/Carlito/OFL.txt"
          Link="Fixtures/Fonts/Carlito-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../freew/FreeW.App.Avalonia/Assets/Fonts/Carlito/UPSTREAM.json"
          Link="Fixtures/Fonts/Carlito-UPSTREAM.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
